[Unit]
Description=Ar3mis Cloud Production Hardening
Documentation=https://github.com/Ar3mis17/Rpi5-Cloud-Host
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/opt/ar3mis-cloud/scripts/harden-production.sh
WorkingDirectory=/opt/ar3mis-cloud
StandardOutput=journal
StandardError=journal

# Run once at boot
RemainAfterExit=yes

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/ssh /etc/ufw /etc/fstab /etc/modprobe.d /etc/sysctl.d /etc/fail2ban /etc/logrotate.d /etc/docker