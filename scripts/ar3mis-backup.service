[Unit]
Description=Ar3mis Cloud Full Backup
Documentation=https://github.com/Ar3mis17/Rpi5-Cloud-Host
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/opt/ar3mis-cloud/scripts/backup-all.sh
WorkingDirectory=/opt/ar3mis-cloud
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryMax=512M
CPUQuota=50%

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/mnt/cloud/backups /opt/ar3mis-cloud/backend/.env