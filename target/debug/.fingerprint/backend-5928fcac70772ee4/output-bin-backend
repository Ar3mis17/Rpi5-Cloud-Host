\n    // Calling the method is still fine, as i32 implements Debug.\n    some_func(5i32);\n\n    // This would fail to compile now:\n    // struct WithoutDebug;\n    // some_func(WithoutDebug);\n}\n```\n\nRust only looks at the signature of the called function, as such it must\nalready specify all requirements that will be used for every type parameter.\n"},"level":"error","spans":[{"file_name":"backend\\src\\services\\storage.rs","byte_start":876,"byte_end":883,"line_start":31,"line_end":31,"column_start":10,"column_end":17,"is_primary":true,"text":[{"text":"        .flatten();","highlight_start":10,"highlight_end":17}],"label":"`!` is not an iterator","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"the trait `Iterator` is not implemented for `!`","code":null,"level":"help","spans":[],"children":[],"rendered":null}],"rendered":"\u001b[1m\u001b[91merror[E0277]\u001b[0m\u001b[1m\u001b[97m: `!` is not an iterator\u001b[0m\n  \u001b[1m\u001b[96m--> \u001b[0mbackend\\src\\services\\storage.rs:31:10\n   \u001b[1m\u001b[96m|\u001b[0m\n\u001b[1m\u001b[96m31\u001b[0m \u001b[1m\u001b[96m|\u001b[0m         .flatten();\n   \u001b[1m\u001b[96m|\u001b[0m          \u001b[1m\u001b[91m^^^^^^^\u001b[0m \u001b[1m\u001b[91m`!` is not an iterator\u001b[0m\n   \u001b[1m\u001b[96m|\u001b[0m\n   \u001b[1m\u001b[96m= \u001b[0m\u001b[1m\u001b[97mhelp\u001b[0m: the trait `Iterator` is not implemented for `!`\n\n"}
