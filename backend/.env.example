POSTGRES_PASSWORD=<your-secure-postgres-password>
POSTGRES_USER=ar3mis_app
POSTGRES_DB=ar3mis_cloud
SECRET_KEY=<your-secure-secret-key>
ALEMBIC_REVISION=<start-with-zero>
AWS_ACCESS_KEY_ID=<if-using-s3>
AWS_SECRET_ACCESS_KEY=<if-using-s3>
AWS_BUCKET_NAME=<if-using-s3>
REDIS_URL=redis://redis:6379/0
BROKER_URL=redis://redis:6379/0
RESULT_BACKEND=django://
DISK_QUOTA_DEFAULT_GB=100
UPLOAD_TEMP_DIR=/tmp/uploads
UPLOAD_MAX_SIZE_MB=100
UPLOAD_CHUNK_SIZE_MB=20
MAX_CONCURRENT_UPLOADS=5
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60
CSRF_COOKIE_NAME=x-csrf-token
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_AGE=86400
TOKEN_ACCESS_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_MINUTES=7
CORS_ALLOW_ORIGINS=https://app.example.com,http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=json
DATABASE_URL=postgresql://ar3mis_app:<password>@db:5432/ar3mis_cloud